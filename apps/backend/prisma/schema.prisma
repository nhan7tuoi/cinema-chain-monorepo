generator client {
  provider     = "prisma-client-js"
  output       = "../node_modules/.prisma/generated"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// 1. PHÂN HỆ AUTHENTICATION & DANH TÍNH (USER, CUSTOMER, EMPLOYEE)
// =========================================================================

enum UserType {
  CUSTOMER
  EMPLOYEE
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  HIDDEN
}

model User {
  id        Int        @id @default(autoincrement())
  email     String?    @unique // Cho phép null để khách hàng đăng ký thuần bằng SĐT
  phone     String?    @unique // SĐT định danh đăng nhập chính (Hệ thống tổng)
  password  String
  userType  UserType   @default(CUSTOMER) // Loại tài khoản cao nhất hoặc mặc định
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Mối quan hệ 1:1 song song. Một User có thể đồng thời có cả profile Customer và Employee
  customer Customer?
  employee Employee?

  @@map("users")
}

model Customer {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName  String
  avatarUrl String?   @db.Text
  points    Int       @default(0)
  rank      String    @default("MEMBER") // MEMBER, VIP, VVIP
  birthDate DateTime?
  slug      String?   @db.VarChar(255)

  bookings Booking[]
  reviews  Review[]

  @@map("customers")
}

model Employee {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName  String
  avatarUrl String? @db.Text
  code      String  @unique // Mã nhân viên nội bộ (Ví dụ: NV001, NV002...)
  slug      String? @db.VarChar(255)

  // Địa bàn làm việc của nhân viên tại cơ sở
  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Vai trò của nhân viên trong hệ thống (Dynamic RBAC)
  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@map("employees")
}

// =========================================================================
// 2. PHÂN HỆ PHÂN QUYỀN ĐỘNG (DYNAMIC RBAC MATRIX)
// =========================================================================

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique // Mã định danh hệ thống viết hoa (Ví dụ: "BRANCH_MANAGER")
  name        String // Tên hiển thị tiếng Việt (Ví dụ: "Quản Lý Chi Nhánh")
  description String?
  isSystem    Boolean  @default(false) // Chặn xóa nhầm các role cấu hình cứng hệ thống
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  employees   Employee[]

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique // Cấu trúc dạng "module:action" (Ví dụ: "movie:create")
  displayName String // Nhãn tiếng Việt để render lên FE (Ví dụ: "Thêm phim mới")
  module      String // Nhóm cha (Ví dụ: "Quản Lý Phim")
  description String?

  roles RolePermission[]

  @@map("permissions")
}

// Bảng trung gian kết nối Nhóm quyền <-> Quyền chi tiết
model RolePermission {
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =========================================================================
// 3. PHÂN HỆ CƠ SỞ HẠ TẦNG (MASTER DATA)
// =========================================================================

model Branch {
  id           Int      @id @default(autoincrement())
  slug         String?  @unique
  name         String   @unique
  address      String
  city         String?
  district     String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  phone        String?
  coverUrl     String?  @db.Text
  mapUrl       String?  @db.Text
  openingHours Json?
  amenities    Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employees   Employee[]
  auditoriums Auditorium[]
  showtimes   Showtime[]

  @@index([city, district])
  @@index([isActive])
  @@map("branches")
}

// =========================================================================
// 4. PHÂN HỆ QUẢN LÝ PHIM (MOVIES)
// =========================================================================

enum MovieStatus {
  NOW_SHOWING
  COMING_SOON
  ENDED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

model Movie {
  id            Int         @id @default(autoincrement())
  slug          String?     @unique
  title         String
  originalTitle String?
  director      String?
  cast          String?
  genre         String?
  duration      Int // Thời lượng (phút)
  releaseDate   DateTime
  endDate       DateTime?
  format        String      @default("2D")
  synopsis      String?     @db.Text
  posterUrl     String?     @db.Text
  backdropUrl   String?     @db.Text
  trailerUrl    String?     @db.Text
  ageRating     String?
  language      String?
  subtitle      String?
  country       String?
  averageRating Decimal?    @db.Decimal(3, 1)
  ratingCount   Int         @default(0)
  viewCount     Int         @default(0)
  isFeatured    Boolean     @default(false)
  featuredOrder Int?
  status        MovieStatus @default(COMING_SOON)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  showtimes Showtime[]
  combos    Combo[]
  reviews   Review[]

  @@index([status, releaseDate])
  @@index([isFeatured, featuredOrder])
  @@map("movies")
}

model Promotion {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  title     String
  summary   String?
  content   String?   @db.Text
  imageUrl  String?   @db.Text
  badge     String?
  startsAt  DateTime?
  endsAt    DateTime?
  terms     String?   @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model Article {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  title       String
  excerpt     String?
  content     String?       @db.Text
  coverUrl    String?       @db.Text
  category    String?
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@map("articles")
}

model Auditorium {
  id       Int    @id @default(autoincrement())
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name       String
  format     String   @default("2D")
  capacity   Int      @default(0)
  isActive   Boolean  @default(true)
  layoutRows Int      @default(0)
  layoutCols Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  showtimes Showtime[]
  seats     Seat[]

  @@unique([branchId, name])
  @@map("auditoriums")
}

// 
enum ShowtimeStatus {
  SCHEDULED
  SELLING
  SOLD_OUT
  CANCELLED
  FINISHED
}

model Showtime {
  id       Int    @id @default(autoincrement())
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  auditoriumId Int
  auditorium   Auditorium @relation(fields: [auditoriumId], references: [id], onDelete: Restrict)

  movieId Int
  movie   Movie @relation(fields: [movieId], references: [id], onDelete: Restrict)

  startsAt  DateTime
  endsAt    DateTime
  status    ShowtimeStatus @default(SCHEDULED)
  basePrice Decimal        @db.Decimal(12, 2)
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  bookings Booking[]

  @@index([branchId, startsAt])
  @@index([auditoriumId, startsAt])
  @@map("showtimes")
}

enum SeatType {
  STANDARD
  VIP
  COUPLE
}

enum SeatStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Seat {
  id           Int        @id @default(autoincrement())
  auditoriumId Int
  auditorium   Auditorium @relation(fields: [auditoriumId], references: [id], onDelete: Cascade)

  rowLabel     String
  number       Int
  code         String
  gridRow      Int
  gridCol      Int
  type         SeatType   @default(STANDARD)
  status       SeatStatus @default(ACTIVE)
  couplePairId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tickets Ticket[]

  @@unique([auditoriumId, code])
  @@unique([auditoriumId, gridRow, gridCol])
  @@index([auditoriumId, rowLabel])
  @@index([auditoriumId, couplePairId])
  @@map("seats")
}

// =========================================================================
// 5. PHÂN HỆ COMBO & VÉ (BOOKING)
// =========================================================================

enum ComboType {
  STANDARD
  MOVIE_SPECIFIC
}

model Combo {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Decimal   @db.Decimal(12, 2)
  imageUrl    String?   @db.Text
  type        ComboType @default(STANDARD)

  // Liên kết với phim (chỉ dùng nếu type = MOVIE_SPECIFIC)
  movieId Int?
  movie   Movie? @relation(fields: [movieId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingCombos BookingCombo[]

  @@index([movieId])
  @@map("combos")
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

model Booking {
  id   Int    @id @default(autoincrement())
  code String @unique

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  showtimeId Int
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Restrict)

  totalAmount Decimal       @db.Decimal(12, 2)
  status      BookingStatus @default(PENDING)

  paymentMethod String?
  paymentStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets       Ticket[]
  bookingCombos BookingCombo[]

  @@map("bookings")
}

model Ticket {
  id        Int     @id @default(autoincrement())
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  seatId Int
  seat   Seat @relation(fields: [seatId], references: [id], onDelete: Restrict)

  price Decimal @db.Decimal(12, 2)

  @@unique([bookingId, seatId])
  @@map("tickets")
}

model BookingCombo {
  id        Int     @id @default(autoincrement())
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  comboId Int
  combo   Combo @relation(fields: [comboId], references: [id], onDelete: Restrict)

  quantity Int
  price    Decimal @db.Decimal(12, 2)

  @@unique([bookingId, comboId])
  @@map("booking_combos")
}

// =========================================================================
// 6. PHÂN HỆ ĐÁNH GIÁ (REVIEWS)
// =========================================================================

model Review {
  id         Int      @id @default(autoincrement())
  movieId    Int
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int // Điểm đánh giá (1-5)
  content    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([movieId])
  @@index([customerId])
  @@map("reviews")
}
